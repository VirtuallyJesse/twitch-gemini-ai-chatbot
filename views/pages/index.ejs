                    staticInput.dispatchEvent(new Event('input', { bubbles: true }));
                }
                updatePreviewFromTemplate();
                flushActiveAlertDetail();
                updateStatusBadge('event_alerts', true, true);
            });

            staticInput?.addEventListener('input', () => {
                updateCounters();
                if (fallbackInput && fallbackInput.value !== staticInput.value) {
                    fallbackInput.value = staticInput.value;
                    fallbackInput.dispatchEvent(new Event('input', { bubbles: true }));
                }
                updatePreviewFromTemplate();
                flushActiveAlertDetail();
                updateStatusBadge('event_alerts', true, true);
            });

            cooldownInput?.addEventListener('input', () => {
                flushActiveAlertDetail();
                updateStatusBadge('event_alerts', true, true);
            });

            extraNum?.addEventListener('input', () => {
                flushActiveAlertDetail();
                updateStatusBadge('event_alerts', true, true);
            });

            extraToggle?.addEventListener('change', () => {
                flushActiveAlertDetail();
                updateStatusBadge('event_alerts', true, true);
            });

            if (btnTestAi) {
                btnTestAi.addEventListener('click', async () => {
                    const rawPrompt = (promptInput?.value || '').trim();
                    if (!rawPrompt) {
                        alert('Please enter an AI prompt first before testing.');
                        return;
                    }
                    const interpolated = interpolate(rawPrompt, spec.sample);
                    btnTestAi.disabled = true;
                    btnTestAi.innerHTML = '✨ Generating...';
                    if (previewTag) {
                        previewTag.style.display = 'inline-block';
                        previewTag.textContent = '⏳ GENERATING...';
                        previewTag.className = 'mock-chat-tag pending';
                    }
                    previewText.textContent = 'Generating real AI response from Gemini...';

                    try {
                        const res = await fetch(`/gemini/${encodeURIComponent(interpolated)}`);
                        if (!res.ok) {
                            const errText = await res.text();
                            throw new Error(errText || 'Failed to generate AI response');
                        }
                        const aiAnswer = await res.text();
                        previewText.textContent = aiAnswer;
                        if (previewTag) {
                            previewTag.textContent = '✨ AI TEST RESULT';
                            previewTag.className = 'mock-chat-tag ai-tested';
                        }
                    } catch (err) {
                        previewText.textContent = `[AI Test Error: ${err.message}]`;
                        if (previewTag) {
                            previewTag.textContent = '⚠️ AI ERROR';
                            previewTag.className = 'mock-chat-tag error';
                        }
                    } finally {
                        btnTestAi.disabled = false;
                        btnTestAi.innerHTML = '✨ Test AI Reply';
                    }
                });
            }

            detailEl.querySelectorAll('.var-pill').forEach(pill => {
                pill.addEventListener('click', () => {
                    const block = pill.closest('.field-block');
                    const target = block ? block.querySelector('.table-input') : promptInput;
                    insertTokenAtCursor(target || promptInput, pill.dataset.var);
                    updateCounters();
                    if (target === fallbackInput || target === staticInput) updatePreviewFromTemplate();
                    flushActiveAlertDetail();
                    updateStatusBadge('event_alerts', true, true);
                });
            });

            els.alertsDetailPanel.appendChild(detailEl);
        }

        function collectAlertsFromForm() {
            flushActiveAlertDetail();
            return structuredClone(state.config?.event_alerts || {});
        }

        function updateErrorsGateVisibility() {
            if (!els.errorsGateOverlay || !els.errorsContentWrapper) return;
            if (state.errorsUnlocked) {
                els.errorsGateOverlay.style.display = 'none';
                els.errorsContentWrapper.style.display = 'block';
            } else {
                els.errorsGateOverlay.style.display = 'flex';
                els.errorsContentWrapper.style.display = 'none';
            }
        }

        // --- 2-PANEL MASTER-DETAIL ERRORS LOGIC ---
        function renderErrorsMasterDetail() {
            updateErrorsGateVisibility();
            if (!state.errorsUnlocked) return;
            if (!state.config?.error_messages) state.config.error_messages = {};
            if (!state.selectedErrorGroup || !ERROR_GROUPS.some(g => g.id === state.selectedErrorGroup)) {
                state.selectedErrorGroup = ERROR_GROUPS[0].id;
            }
            renderErrorsNav();
            renderErrorsDetail(state.selectedErrorGroup);
        }

        function renderErrorsNav() {
            if (!els.errorsNavList) return;
            els.errorsNavList.innerHTML = '';

            ERROR_GROUPS.forEach(group => {
                const navItem = document.createElement('div');
                navItem.className = `errors-nav-item ${state.selectedErrorGroup === group.id ? 'active' : ''}`;
                navItem.dataset.id = group.id;

                navItem.innerHTML = `
                    <div class="errors-nav-left">
                        <span class="errors-nav-icon">${group.icon}</span>
                        <span class="errors-nav-title">${escapeHtml(group.name)}</span>
                    </div>
                    <span class="errors-nav-count">${group.keys.length}</span>
                `;

                navItem.addEventListener('click', () => {
                    if (state.selectedErrorGroup !== group.id) {
                        selectErrorGroup(group.id);
                    }
                });

                els.errorsNavList.appendChild(navItem);
            });
        }

        function selectErrorGroup(groupId) {
            state.selectedErrorGroup = groupId;
            if (els.errorsNavList) {
                els.errorsNavList.querySelectorAll('.errors-nav-item').forEach(item => {
                    item.classList.toggle('active', item.dataset.id === groupId);
                });
            }
            renderErrorsDetail(groupId);
        }

        function renderErrorsDetail(groupId) {
            if (!els.errorsDetailPanel) return;
            els.errorsDetailPanel.innerHTML = '';

            const group = ERROR_GROUPS.find(g => g.id === groupId) || ERROR_GROUPS[0];
            if (!group) return;

            const errors = state.config?.error_messages || {};

            const detailEl = document.createElement('div');
            detailEl.className = 'errors-detail-content';

            detailEl.innerHTML = `
                <div class="errors-detail-header">
                    <div class="errors-detail-title-group">
                        <strong class="errors-detail-title">${group.icon} ${escapeHtml(group.name)}</strong>
                        <span class="errors-detail-desc">${escapeHtml(group.desc)}</span>
                    </div>
                    <button type="button" class="btn btn-secondary btn-reset-group" title="Reset all errors in this category to factory default">↺ Reset Category</button>
                </div>
                <div class="errors-items-list"></div>
            `;

            const itemsContainer = detailEl.querySelector('.errors-items-list');
            const btnResetGroup = detailEl.querySelector('.btn-reset-group');

            btnResetGroup.addEventListener('click', () => {
                group.keys.forEach(k => {
                    const defVal = FACTORY_ERRORS[k.key] || '';
                    state.config.error_messages[k.key] = defVal;
                });
                renderErrorsDetail(groupId);
                updateStatusBadge('error_messages', true, true);
            });

            group.keys.forEach(item => {
                const curVal = errors[item.key] !== undefined ? errors[item.key] : (FACTORY_ERRORS[item.key] || '');
                const card = document.createElement('div');
                card.className = 'error-item-card';
                card.dataset.key = item.key;

                const pillsHtml = (item.vars || []).map(v => 
                    `<button type="button" class="var-pill" data-var="{${v}}">+ {${v}}</button>`
                ).join('');

                card.innerHTML = `
                    <div class="error-item-header">
                        <div class="error-key-group">
                            <span class="error-key-badge">${escapeHtml(item.key)}</span>
                            <span class="error-desc">${escapeHtml(item.desc)}</span>
                        </div>
                        <button type="button" class="btn-item-reset" data-key="${item.key}" title="Reset to factory default">↺ Reset</button>
                    </div>
                    <div class="error-input-block">
                        <div class="highlight-input-wrapper multiline">
                            <div class="highlight-backdrop" aria-hidden="true"></div>
                            <textarea class="table-input code-font highlight-textarea error-msg-input" rows="1" maxlength="450" placeholder="Chat fallback message..." spellcheck="false" autocomplete="off">${escapeHtml(curVal)}</textarea>
                        </div>
                        <div class="var-pills-row" style="margin-top: 2px;">
                            <div class="pills-group">${pillsHtml}</div>
                            <span class="char-counter error-counter">${curVal.length} / 450 chars</span>
                        </div>
                    </div>
                `;

                const input = card.querySelector('.error-msg-input');
                const btnReset = card.querySelector('.btn-item-reset');
                const counter = card.querySelector('.error-counter');

                attachInputSyntaxHighlighter(input, item.vars || []);

                const updateCount = () => {
                    if (counter && input) {
                        const len = input.value.length;
                        counter.textContent = `${len} / 450 chars`;
                        counter.classList.toggle('warning', len > 400);
                        counter.classList.toggle('error', len > 450);
                    }
                };

                input.addEventListener('input', () => {
                    updateCount();
                    state.config.error_messages[item.key] = input.value;
                    updateStatusBadge('error_messages', true, true);
                });

                btnReset.addEventListener('click', () => {
                    const defaultVal = FACTORY_ERRORS[item.key] || '';
                    input.value = defaultVal;
                    input.dispatchEvent(new Event('input', { bubbles: true }));
                    state.config.error_messages[item.key] = defaultVal;
                    updateCount();
                    updateStatusBadge('error_messages', true, true);
                });

                card.querySelectorAll('.var-pill').forEach(pill => {
                    pill.addEventListener('click', () => {
                        insertTokenAtCursor(input, pill.dataset.var);
                        state.config.error_messages[item.key] = input.value;
                        updateCount();
                        updateStatusBadge('error_messages', true, true);
                    });
                });

                updateCount();
                itemsContainer.appendChild(card);
            });

            els.errorsDetailPanel.appendChild(detailEl);
        }

        function collectErrorsFromForm() {
            return structuredClone(state.config?.error_messages || {});
        }

        async function saveConfig(type) {
            if (!els.modalSaveNotice) return;
            els.modalSaveNotice.className = 'modal-save-notice';
            els.modalSaveNotice.textContent = 'Saving...';

            let payload;
            try {
                if (type === 'system_instructions') {
                    payload = els.personaTextarea?.value || '';
                } else if (type === 'custom_commands') {
                    payload = collectCommandsFromTable();
                } else if (type === 'event_alerts') {
                    payload = collectAlertsFromForm();
                } else if (type === 'error_messages') {
                    payload = collectErrorsFromForm();
                }
            } catch (err) {
                els.modalSaveNotice.className = 'modal-save-notice error';
                els.modalSaveNotice.textContent = `Error preparing data: ${err.message}`;
                return;
            }

            try {
                const res = await fetch(`/api/config/${type}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ value: payload })
                });
                const data = await res.json();
                if (!res.ok) {
                    throw new Error(data.message || data.error || 'Save failed');
                }
                els.modalSaveNotice.textContent = `✓ ${type.replace('_', ' ')} saved successfully.`;
                updateStatusBadge(type, data.override);
                setTimeout(() => {
                    if (els.modalSaveNotice && els.modalSaveNotice.textContent.includes('✓')) {
                        els.modalSaveNotice.textContent = '';
                    }
                }, 3000);
            } catch (err) {
                els.modalSaveNotice.className = 'modal-save-notice error';
                els.modalSaveNotice.textContent = `Failed to save: ${err.message}`;
            }
        }

        async function resetConfig(type) {
            const labelMap = {
                system_instructions: 'Persona',
                custom_commands: 'Commands',
                event_alerts: 'Alerts',
                error_messages: 'Errors'
            };
            const label = labelMap[type] || type.replace('_', ' ');
            if (!confirm(`Reset all ${label} to factory default presets? This will overwrite your current ${label.toLowerCase()} configuration.`)) return;
            if (!els.modalSaveNotice) return;
            els.modalSaveNotice.className = 'modal-save-notice';
            els.modalSaveNotice.textContent = `Resetting ${label}...`;

            try {
                const res = await fetch(`/api/config/${type}/reset`, { method: 'POST' });
                const data = await res.json();
                if (!res.ok) {
                    throw new Error(data.message || data.error || 'Reset failed');
                }
                els.modalSaveNotice.textContent = `✓ Reverted ${label} to factory default.`;
                if (!state.config) state.config = {};
                state.config[type] = data.value;
                if (!state.config.overrides) state.config.overrides = {};
                state.config.overrides[type] = data.override;
                renderConfigForm();
                setTimeout(() => {
                    if (els.modalSaveNotice && els.modalSaveNotice.textContent.includes('✓')) {
                        els.modalSaveNotice.textContent = '';
                    }
                }, 3000);
            } catch (err) {
                els.modalSaveNotice.className = 'modal-save-notice error';
                els.modalSaveNotice.textContent = `Reset failed: ${err.message}`;
            }
        }

        // --- CHAT LOGIC ---
        async function fetchChat(channel) {
            const safeChannel = channel.replace('#', '');
            const res = await fetch(`/api/chat/${safeChannel}`);
            const data = await res.json();
            state.chatData[channel] = data;
            if (state.activeChannel === channel) {
                renderChat();
            }
        }

        function switchChannel(channel) {
            state.activeChannel = channel;
            renderTabs();

            // Ensure we have 3P emote maps for this channel (async, cached)
            ensureEmotesLoaded(channel).then(() => {
                if (state.activeChannel === channel) renderChat();
            }).catch(() => { /* non-fatal */ });

            if (!state.chatData[channel]) {
                fetchChat(channel);
            } else {
                renderChat();
            }
        }

        function renderTabs() {
            els.tabs.innerHTML = state.channels.map(ch => {
                const status = state.channelStatuses[ch];
                const isUnlinked = status && !status.authorized;
                const warnBadge = isUnlinked ? '<span class="tab-warn" title="Stream controls unlinked">⚠️</span>' : '';
                return `
                    <div class="tab ${ch === state.activeChannel ? 'active' : ''} ${isUnlinked ? 'tab-unlinked' : ''}" 
                         onclick="switchChannel('${ch}')">
                        ${ch}${warnBadge}
                    </div>
                `;
            }).join('');
            renderAuthPill();
        }

        function renderAuthPill() {
            const pillEl = document.getElementById('channel-auth-pill');
            if (!pillEl || !state.activeChannel) return;

            const ch = state.activeChannel;
            const status = state.channelStatuses[ch];
            if (status && !status.authorized) {
                const safe = ch.replace('#', '');
                pillEl.style.display = 'inline-flex';
                pillEl.innerHTML = `
                    <span class="unlinked-pill" title="Twitch broadcaster token required for stream category and title changes">
                        ⚠️ Stream controls unlinked
                        <button class="btn-link-broadcaster" onclick="linkBroadcaster('${safe}')">Link Broadcaster</button>
                    </span>
                `;
            } else {
                pillEl.style.display = 'none';
                pillEl.innerHTML = '';
            }
        }

        function linkBroadcaster(channel) {
            const safe = String(channel || '').replace('#', '');
            const w = 600;
            const h = 700;
            const left = window.screenX + (window.outerWidth - w) / 2;
            const top = window.screenY + (window.outerHeight - h) / 2;
            window.open(
                `/auth/broadcaster?channel=${encodeURIComponent(safe)}`,
                'twitch_broadcaster_auth',
                `width=${w},height=${h},left=${left},top=${top},status=no,menubar=no,toolbar=no`
            );
        }

        function renderChat() {
            const msgs = state.chatData[state.activeChannel] || [];
            const visibleMsgs = msgs.slice(-200);

            els.chatLog.innerHTML = visibleMsgs.map(msg => {
                const date = new Date(msg.timestamp);
                const timeStr = date.toLocaleTimeString([], { hour12: false, hour: '2-digit', minute:'2-digit', second:'2-digit' });
                const rendered = renderMessageHtml(msg.message, state.activeChannel, msg.meta, state.emoteMapsByChannel);

                return `
                    <div class="chat-msg">
                        <span class="ts">[${timeStr}]</span>
                        <span class="user" style="color: ${getUsernameColor(msg.username)}">${escapeHtml(msg.username)}:</span>
                        <span class="text">${rendered}</span>
                    </div>
                `;
            }).join('');

            scrollToBottom();
        }

        function appendMessage(channel, msg) {
            if (!state.chatData[channel]) state.chatData[channel] = [];
            state.chatData[channel].push(msg);

            if (state.chatData[channel].length > 1000) state.chatData[channel].shift();

            if (state.activeChannel === channel) {
                const isScrolledBottom = els.chatLog.scrollHeight - els.chatLog.scrollTop === els.chatLog.clientHeight;
                const date = new Date(msg.timestamp);
                const timeStr = date.toLocaleTimeString([], { hour12: false, hour: '2-digit', minute:'2-digit', second:'2-digit' });
                const rendered = renderMessageHtml(msg.message, channel, msg.meta, state.emoteMapsByChannel);

                const html = `
                    <div class="chat-msg">
                        <span class="ts">[${timeStr}]</span>
                        <span class="user" style="color: ${getUsernameColor(msg.username)}">${escapeHtml(msg.username)}:</span>
                        <span class="text">${rendered}</span>
                    </div>
                `;
                els.chatLog.insertAdjacentHTML('beforeend', html);

                if (isScrolledBottom) scrollToBottom();
            }
        }

        function scrollToBottom() {
            els.chatLog.scrollTop = els.chatLog.scrollHeight;
        }

        // --- MEDIA LOGIC ---
        function setFilter(type) {
            state.mediaFilter = type;
            state.mediaPage = 1;
            document.querySelectorAll('.filter-btn').forEach(b => {
                b.classList.toggle('active', b.getAttribute('onclick').includes(type));
            });
            renderGallery();
        }

        function renderGallery() {
            const filtered = state.mediaFilter === 'all' 
                ? state.mediaData 
                : state.mediaData.filter(m => {
                    if (state.mediaFilter === 'audio') {
                        return ['audio', 'music', 'tts'].includes(m.mediaType);
                    }
                    return m.mediaType === state.mediaFilter;
                });

            const totalPages = Math.max(1, Math.ceil(filtered.length / state.mediaPerPage));
            if (state.mediaPage > totalPages) state.mediaPage = totalPages;
            if (state.mediaPage < 1) state.mediaPage = 1;

            const start = (state.mediaPage - 1) * state.mediaPerPage;
            const pageItems = filtered.slice(start, start + state.mediaPerPage);

            els.gallery.innerHTML = pageItems.map(item => createMediaCard(item)).join('');
            renderPagination(totalPages, filtered.length);
            observeImages();
        }

        function prependMedia(item) {
            state.mediaData.unshift(item);
            if (state.mediaFilter === 'all' || 
                state.mediaFilter === item.mediaType || 
                (state.mediaFilter === 'audio' && ['audio', 'music', 'tts'].includes(item.mediaType))) {
                renderGallery();
            }
        }

        function createMediaCard(item) {
            const date = new Date(item.timestamp);
            const timeStr = date.toLocaleString();
            
            let mediaContent = '';
            if (item.mediaType === 'image') {
                mediaContent = `<img data-src="${item.mediaUrl}" class="lazy-media" alt="Generated Image" onclick="window.open('${item.mediaUrl}', '_blank')">`;
            } else if (item.mediaType === 'video') {
                mediaContent = `
                    <video controls preload="none" poster="">
                        <source src="${item.mediaUrl}" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>`;
            } else if (item.mediaType === 'audio' || item.mediaType === 'music' || item.mediaType === 'tts') {
                mediaContent = `
                    <div class="audio-player">
                        <div class="audio-icon">🎵</div>
                        <audio controls preload="none">
                            <source src="${item.mediaUrl}" type="audio/mpeg">
                        </audio>
                    </div>`;
            }

            return `
                <div class="media-card">
                    <div class="media-content">
                        ${mediaContent}
                    </div>
                    <div class="media-info">
                        <div class="prompt" title="${escapeHtml(item.prompt)}">"${item.prompt}"</div>
                        <div class="meta" title="${escapeHtml(item.command)} by ${escapeHtml(item.username)} - ${timeStr}">
                            <span class="cmd">${item.command}</span>
                            <span class="by">by ${escapeHtml(item.username)}</span>
                            <span class="at">${timeStr}</span>
                        </div>
                    </div>
                </div>
            `;
        }

        function observeImages() {
            const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const img = entry.target;
                        img.src = img.dataset.src;
                        img.classList.remove('lazy-media');
                        obs.unobserve(img);
                    }
                });
            });
            document.querySelectorAll('.lazy-media').forEach(img => observer.observe(img));
        }

        function renderPagination(totalPages, totalItems) {
            if (!els.pagination) return;
            if (totalPages <= 1) {
                els.pagination.innerHTML = `<span class="page-info">${totalItems} item${totalItems !== 1 ? 's' : ''}</span>`;
                return;
            }

            let html = '';
            html += `<button class="page-btn" onclick="goToPage(1)" ${state.mediaPage === 1 ? 'disabled' : ''}>&laquo;</button>`;
            html += `<button class="page-btn" onclick="goToPage(${state.mediaPage - 1})" ${state.mediaPage === 1 ? 'disabled' : ''}>&lsaquo;</button>`;

            const maxVisible = 5;
            let startPage = Math.max(1, state.mediaPage - Math.floor(maxVisible / 2));
            let endPage = Math.min(totalPages, startPage + maxVisible - 1);
            if (endPage - startPage + 1 < maxVisible) {
                startPage = Math.max(1, endPage - maxVisible + 1);
            }

            for (let i = startPage; i <= endPage; i++) {
                html += `<button class="page-btn ${i === state.mediaPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
            }

            html += `<button class="page-btn" onclick="goToPage(${state.mediaPage + 1})" ${state.mediaPage === totalPages ? 'disabled' : ''}>&rsaquo;</button>`;
            html += `<button class="page-btn" onclick="goToPage(${totalPages})" ${state.mediaPage === totalPages ? 'disabled' : ''}>&raquo;</button>`;
            html += `<span class="page-info">Page ${state.mediaPage} of ${totalPages} (${totalItems} items)</span>`;

            els.pagination.innerHTML = html;
        }

        function goToPage(page) {
            state.mediaPage = page;
            renderGallery();
            els.gallery.scrollTop = 0;
        }

        function updateChannelAuthStatus(channel, authorized) {
            if (!channel) return;
            const raw = String(channel);
            const ch = raw.startsWith('#') ? raw : '#' + raw;
            if (!state.channelStatuses[ch]) {
                state.channelStatuses[ch] = { channel: ch, isBot: false };
            }
            state.channelStatuses[ch].authorized = Boolean(authorized);
            renderTabs();
        }

        // --- WEBSOCKET ---
        function connectWS() {
            const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
            const wsUrl = `${protocol}://${window.location.host}/ws`;
            state.socket = new WebSocket(wsUrl);

            state.socket.onopen = () => console.log("WS Connected");
            state.socket.onclose = () => setTimeout(connectWS, 3000);
            state.socket.onmessage = (event) => {
                const data = JSON.parse(event.data);
                if (data.type === 'chat') {
                    appendMessage(data.channel, data.entry);
                } else if (data.type === 'media') {
                    prependMedia(data.entry);
                } else if (data.type === 'emotes:update' && data.channel) {
                    state.emoteMapsByChannel[data.channel] = data.emotes || {};
                    if (state.activeChannel === data.channel) renderChat();
                } else if (data.type === 'auth:broadcaster' && data.channel) {
                    updateChannelAuthStatus(data.channel, data.authorized);
                } else if (data.type === 'config:updated') {
                    if (window.__VIEWER__ && window.__VIEWER__.isAdmin) {
                        loadConfig();
                    }
                }
            };
        }

        // --- POPUP NOTIFICATION LISTENER ---
        window.addEventListener('message', (event) => {
            if (event.data?.type === 'twitch:broadcaster_authorized' && event.data.channel) {
                updateChannelAuthStatus(event.data.channel, true);
            }
        });

        // --- HELPERS ---
        function getUsernameColor(username) {
            let hash = 0;
            for (let i = 0; i < username.length; i++) {
                hash = username.charCodeAt(i) + ((hash << 5) - hash);
            }
            const c = (hash & 0x00FFFFFF).toString(16).toUpperCase();
            return '#' + '00000'.substring(0, 6 - c.length) + c;
        }

        async function ensureEmotesLoaded(channel) {
            if (state.emoteMapsByChannel[channel]) return state.emoteMapsByChannel[channel];
            const safe = String(channel || '').replace(/^#/, '');
            const res = await fetch(`/api/emotes/${encodeURIComponent(safe)}`);
            if (!res.ok) return {};
            const map = await res.json();
            state.emoteMapsByChannel[channel] = map;
            return map;
        }

        // Expose global handlers for inline HTML onclick attributes
        window.setFilter = setFilter;
        window.switchChannel = switchChannel;
        window.goToPage = goToPage;
        window.linkBroadcaster = linkBroadcaster;
        window.updateChannelAuthStatus = updateChannelAuthStatus;

        // Start
        init();
    </script>
</body>
</html>
