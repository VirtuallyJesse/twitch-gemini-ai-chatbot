<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/public/style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Gemini Bot Dashboard</title>
    <script>
        window.__VIEWER__ = <%- JSON.stringify(viewer || null) %>;
    </script>
</head>
<body class="dashboard-body<%= storageConfigured ? '' : ' no-storage' %>">
    <div class="dashboard-container">
        <!-- LEFT PANEL: CHAT LOG -->
        <div class="panel left-panel">
            <div class="panel-header">
                <div class="channel-tabs" id="channel-tabs">
                    <!-- Tabs injected here -->
                    <div class="tab">Loading...</div>
                </div>
                <div class="channel-auth-pill" id="channel-auth-pill" style="display: none;"></div>
            </div>
            <div class="chat-log" id="chat-log">
                <!-- Messages injected here -->
            </div>
        </div>

        <!-- RIGHT PANEL: MEDIA GALLERY -->
        <div class="panel right-panel">
            <div class="panel-header">
                <div class="header-title">Media Gallery</div>
                <div class="filters">
                    <button class="filter-btn active" onclick="setFilter('all')">All</button>
                    <button class="filter-btn" onclick="setFilter('image')">Images</button>
                    <button class="filter-btn" onclick="setFilter('video')">Videos</button>
                    <button class="filter-btn" onclick="setFilter('audio')">Audio</button>
                </div>
                <!-- User Chip / Auth -->
                <div class="user-chip-container" id="user-chip-container">
                    <% if (!viewer || !viewer.login) { %>
                        <a href="/auth/dashboard" class="user-chip unauthenticated" id="user-chip">
                            <span class="chip-avatar" style="display:flex;align-items:center;justify-content:center;">👤</span>
                            <span class="chip-label">Sign in with Twitch</span>
                        </a>
                    <% } else { %>
                        <button class="user-chip" id="user-chip-btn" aria-haspopup="true" aria-expanded="false">
                            <% if (viewer.profileImageUrl) { %>
                                <img src="<%= viewer.profileImageUrl %>" alt="<%= viewer.displayName %>" class="chip-avatar" onerror="this.style.display='none'">
                            <% } else { %>
                                <span class="chip-avatar" style="display:flex;align-items:center;justify-content:center;">👤</span>
                            <% } %>
                            <span class="chip-label"><%= viewer.displayName || viewer.login %></span>
                            <% if (viewer.isAdmin) { %>
                                <span class="admin-badge">Admin</span>
                            <% } %>
                        </button>
                        <div class="user-drawer" id="user-drawer" style="display: none;">
                            <div class="drawer-header">
                                <strong><%= viewer.displayName || viewer.login %></strong>
                                <span class="drawer-role"><%= viewer.isAdmin ? 'Bot Administrator' : 'Viewer' %></span>
                            </div>
                            <% if (viewer.isAdmin) { %>
                                <button class="drawer-item" id="open-config-btn">⚙️ Bot Configuration</button>
                            <% } %>
                            <a href="/auth/logout" class="drawer-item drawer-logout">Sign Out</a>
                        </div>
                    <% } %>
                </div>
            </div>
            <div class="pagination-controls" id="pagination-controls"></div>
            <div class="media-gallery" id="media-gallery">
                <!-- Media cards injected here -->
            </div>
        </div>
    </div>

    <!-- CONFIG MODAL (ADMIN ONLY) -->
    <% if (viewer && viewer.isAdmin) { %>
    <div class="modal-backdrop" id="config-modal" style="display: none;">
        <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="config-modal-title">
            <div class="modal-header">
                <h2 id="config-modal-title">⚙️ Bot Configuration</h2>
                <button class="modal-close" id="close-config-btn" aria-label="Close">&times;</button>
            </div>
            <div class="modal-nav">
                <button class="modal-tab active" data-tab="system_instructions">Persona</button>
                <button class="modal-tab" data-tab="custom_commands">Commands</button>
                <button class="modal-tab" data-tab="event_alerts">Alerts</button>
                <button class="modal-tab" data-tab="error_messages">Errors</button>
            </div>
            <div class="modal-body">
                <!-- Tab 1: Persona -->
                <div class="tab-pane active" id="pane-system_instructions">
                    <div class="pane-header">
                        <span class="pane-status" id="status-system_instructions"><span class="status-dot">●</span> Factory Preset</span>
                        <div class="pane-actions">
                            <button class="btn btn-secondary btn-reset" data-type="system_instructions" title="Restore factory default persona preset">↺ Restore Defaults</button>
                            <button class="btn btn-primary btn-save" data-type="system_instructions">Save Persona</button>
                        </div>
                    </div>
                    <div class="config-guidance">
                        <strong>💡 Tip:</strong> Define the bot's personality and channel rules. Wrap instructions in <code>&lt;tags&gt;</code> for best results.
                    </div>
                    <textarea class="config-textarea" id="input-system_instructions" rows="16" placeholder="Enter bot persona and instructions..."></textarea>
                    <div class="char-counter" id="persona-char-counter">0 / 16,000 characters</div>
                </div>

                <!-- Tab 2: Custom Commands -->
                <div class="tab-pane" id="pane-custom_commands" style="display: none;">
                    <div class="pane-header">
                        <span class="pane-status" id="status-custom_commands"><span class="status-dot">●</span> Factory Preset</span>
                        <div class="pane-actions">
                            <button class="btn btn-secondary" id="btn-add-command">+ Add Command</button>
                            <button class="btn btn-secondary btn-reset" data-type="custom_commands" title="Restore factory default commands preset">↺ Restore Defaults</button>
                            <button class="btn btn-primary btn-save" data-type="custom_commands">Save Commands</button>
                        </div>
                    </div>
                    <div class="pane-toolbar">
                        <input type="text" class="table-input search-input" id="search-commands" placeholder="🔍 Filter commands by name, alias, or response..." autocomplete="off">
                    </div>
                    <div class="commands-table-container">
                        <table class="commands-table" id="commands-table">
                            <thead>
                                <tr>
                                    <th style="width: 22%;">Command</th>
                                    <th style="width: 22%;">Aliases</th>
                                    <th style="width: 36%;">Response</th>
                                    <th style="width: 14%;">Permission</th>
                                    <th style="width: 6%; text-align: center;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="commands-tbody">
                                <!-- Command rows injected here -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 3: Event Alerts (Master-Detail 2-Panel) -->
                <div class="tab-pane" id="pane-event_alerts" style="display: none;">
                    <div class="pane-header">
                        <span class="pane-status" id="status-event_alerts"><span class="status-dot">●</span> Factory Preset</span>
                        <div class="pane-actions">
                            <button class="btn btn-secondary btn-reset" data-type="event_alerts" title="Restore factory default alerts preset">↺ Restore Defaults</button>
                            <button class="btn btn-primary btn-save" data-type="event_alerts">Save Alerts</button>
                        </div>
                    </div>
                    <div class="alerts-master-detail" id="alerts-master-detail">
                        <!-- Left Master Nav List -->
                        <div class="alerts-nav-panel">
                            <div class="alerts-nav-header">
                                <span class="nav-panel-title">Twitch Events</span>
                            </div>
                            <div class="alerts-nav-list" id="alerts-nav-list">
                                <!-- Nav item cards injected here -->
                            </div>
                        </div>
                        <!-- Right Detail Editor Canvas -->
                        <div class="alerts-detail-panel" id="alerts-detail-panel">
                            <!-- Detail editor injected here -->
                        </div>
                    </div>
                </div>

                <!-- Tab 4: Error Messages (2-Panel Master-Detail) -->
                <div class="tab-pane" id="pane-error_messages" style="display: none;">
                    <!-- Advanced User Gate Blocker -->
                    <div class="errors-gate-overlay" id="errors-gate-overlay">
                        <div class="errors-gate-card">
                            <div class="errors-gate-icon">⚠️</div>
                            <strong class="errors-gate-title">This section is for advanced users!</strong>
                            <button type="button" class="btn btn-primary btn-errors-proceed" id="btn-errors-proceed">Proceed</button>
                        </div>
                    </div>

                    <!-- Main Errors Content (Hidden behind gate until unlocked) -->
                    <div class="errors-content-wrapper" id="errors-content-wrapper" style="display: none;">
                        <div class="pane-header">
                            <span class="pane-status" id="status-error_messages"><span class="status-dot">●</span> Factory Preset</span>
                            <div class="pane-actions">
                                <button class="btn btn-secondary btn-reset" data-type="error_messages" title="Restore factory default errors preset">↺ Restore Defaults</button>
                                <button class="btn btn-primary btn-save" data-type="error_messages">Save Errors</button>
                            </div>
                        </div>
                        <div class="config-guidance errors-guidance">
                            <strong>💡 Tip:</strong> Error messages are pre-written fallback notices sent to chat if an external API or service fails. The bot works reliably out of the box with factory defaults. Customize these only if you want bot failure responses to match your channel's unique persona.
                        </div>

                        <!-- 2-Panel Master-Detail Error Catalog -->
                        <div class="errors-master-detail" id="errors-master-detail">
                            <!-- Left Categories Nav -->
                            <div class="errors-nav-panel">
                                <div class="errors-nav-header">
                                    <span class="nav-panel-title">Categories</span>
                                </div>
                                <div class="errors-nav-list" id="errors-nav-list">
                                    <!-- Nav category items injected here -->
                                </div>
                            </div>
                            <!-- Right Detail Panel Canvas -->
                            <div class="errors-detail-panel" id="errors-detail-panel">
                                <!-- Category error items injected here -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <span class="modal-save-notice" id="modal-save-notice"></span>
            </div>
        </div>
    </div>
    <% } %>

    <% if (!storageConfigured) { %>
    <div class="critical-banner">
        🚨 <strong>Upstash Redis is REQUIRED</strong> — Authorization token refreshing and chat persistence will not work without it.
        Set <code>UPSTASH_REDIS_URL</code> in your environment variables to enable the bot.
        <a href="https://upstash.com" target="_blank" rel="noopener">Get a free database →</a>
    </div>
    <% } %>

