        function interpolate(template, vars) {
            return String(template ?? '').replace(/\{(\w+)\}/g, (_, key) => {
                const v = vars[key];
                return v == null ? `{${key}}` : String(v);
            });
        }

        function insertTokenAtCursor(inputEl, token) {
            if (!inputEl) return;
            const start = inputEl.selectionStart ?? inputEl.value.length;
            const end = inputEl.selectionEnd ?? inputEl.value.length;
            const oldVal = inputEl.value;
            inputEl.value = oldVal.substring(0, start) + token + oldVal.substring(end);
            const newPos = start + token.length;
            inputEl.setSelectionRange(newPos, newPos);
            inputEl.focus();
            inputEl.dispatchEvent(new Event('input', { bubbles: true }));
        }

        // --- INITIALIZATION ---
        async function init() {
            try {
                // Non-destructive error retry listener for emote images in chat
                if (els.chatLog) {
                    els.chatLog.addEventListener('error', (event) => {
                        const target = event.target;
                        if (target && target.tagName === 'IMG' && target.classList.contains('emote-img')) {
                            handleEmoteError(target);
                        }
                    }, true);
                }

                // Setup User Drawer and Config Modal if present
                setupUserAuthUI();

                // 1. Fetch Channels and Channel Statuses
                const [channelsRes, statusRes] = await Promise.all([
                    fetch('/api/channels'),
                    fetch('/api/channel-status').catch(() => null)
                ]);
                state.channels = await channelsRes.json();
                if (statusRes && statusRes.ok) {
                    state.channelStatuses = await statusRes.json();
                }

                if (state.channels.length > 0) {
                    state.activeChannel = state.channels[0];
                    renderTabs();
                }

                // 2. Pre-warm emote maps for all connected channels & fetch active chat
                if (state.channels.length > 0) {
                    await Promise.all([
                        state.activeChannel ? fetchChat(state.activeChannel) : Promise.resolve(),
                        ...state.channels.map(ch => ensureEmotesLoaded(ch))
                    ]);
                    renderChat(); // rerender with loaded emotes
                }

                // 3. Fetch Initial Media
                const mediaRes = await fetch('/api/media');
                state.mediaData = await mediaRes.json();
                renderGallery();

                // 4. If admin, load initial bot config
                if (window.__VIEWER__ && window.__VIEWER__.isAdmin) {
                    loadConfig();
                }

                // 5. Connect WebSocket
                connectWS();

            } catch (e) {
                console.error("Init failed", e);
            }
        }

        // --- AUTH & CONFIG UI ---
        function setupUserAuthUI() {
            if (els.userChipBtn && els.userDrawer) {
                els.userChipBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isOpen = els.userDrawer.style.display !== 'none';
                    els.userDrawer.style.display = isOpen ? 'none' : 'flex';
                    els.userChipBtn.setAttribute('aria-expanded', String(!isOpen));
                });

                document.addEventListener('click', (e) => {
                    if (!els.userDrawer.contains(e.target) && e.target !== els.userChipBtn) {
                        els.userDrawer.style.display = 'none';
                        els.userChipBtn.setAttribute('aria-expanded', 'false');
                    }
                });
            }

            if (els.openConfigBtn && els.configModal) {
                els.openConfigBtn.addEventListener('click', () => {
                    els.userDrawer.style.display = 'none';
                    openConfigModal();
                });
            }

            if (els.closeConfigBtn && els.configModal) {
                els.closeConfigBtn.addEventListener('click', closeConfigModal);
                els.configModal.addEventListener('click', (e) => {
                    if (e.target === els.configModal) {
                        const dialog = els.configModal.querySelector('.modal-dialog');
                        if (dialog) {
                            dialog.classList.remove('modal-shake');
                            void dialog.offsetWidth;
                            dialog.classList.add('modal-shake');
                            dialog.addEventListener('animationend', () => {
                                dialog.classList.remove('modal-shake');
                            }, { once: true });
                        }
                    }
                });
                window.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape' && els.configModal && els.configModal.style.display !== 'none') {
                        closeConfigModal();
                    }
                });
            }

            // Scroll stabilization on accordion toggle to prevent bumpy jumps
            const modalBody = els.configModal?.querySelector('.modal-body');
            if (modalBody) {
                modalBody.addEventListener('click', (e) => {
                    const summary = e.target.closest('summary');
                    if (!summary) return;
                    if (e.target.closest('button, input, select, label')) return;

                    const containerRect = modalBody.getBoundingClientRect();
                    const summaryRect = summary.getBoundingClientRect();
                    const initialOffsetTop = summaryRect.top - containerRect.top;

                    requestAnimationFrame(() => {
                        const newSummaryRect = summary.getBoundingClientRect();
                        const newOffsetTop = newSummaryRect.top - containerRect.top;
                        const diff = newOffsetTop - initialOffsetTop;
                        if (Math.abs(diff) > 0.5) {
                            modalBody.scrollTop += diff;
                        }
                    });
                });
            }

            // Tab switching in Config Modal
            document.querySelectorAll('.modal-tab').forEach(tab => {
                tab.addEventListener('click', () => {
                    const targetTab = tab.dataset.tab;
                    switchModalTab(targetTab);
                });
            });

            // Save and Reset buttons
            document.querySelectorAll('.btn-save').forEach(btn => {
                btn.addEventListener('click', () => saveConfig(btn.dataset.type));
            });

            document.querySelectorAll('.btn-reset').forEach(btn => {
                btn.addEventListener('click', () => resetConfig(btn.dataset.type));
            });

            if (els.btnAddCommand) {
                els.btnAddCommand.addEventListener('click', () => {
                    addCommandRow({ command: '', response: '', role: 'all' });
                    updateStatusBadge('custom_commands', true, true);
                });
            }

            if (els.personaTextarea) {
                els.personaTextarea.addEventListener('input', () => {
                    updatePersonaCounter();
                    updateStatusBadge('system_instructions', true, true);
                });
            }

            if (els.btnErrorsProceed) {
                els.btnErrorsProceed.addEventListener('click', () => {
                    state.errorsUnlocked = true;
                    updateErrorsGateVisibility();
                    renderErrorsMasterDetail();
                });
            }

            // Search filters
            if (els.searchCommands) {
                els.searchCommands.addEventListener('input', () => {
                    const q = (els.searchCommands.value || '').trim().toLowerCase();
                    if (!els.commandsTbody) return;
                    els.commandsTbody.querySelectorAll('tr').forEach(row => {
                        const cmd = row.querySelector('.cmd-name')?.value.toLowerCase() || '';
                        const aliases = row.querySelector('.cmd-aliases')?.value.toLowerCase() || '';
                        const resp = row.querySelector('.cmd-resp')?.value.toLowerCase() || '';
                        const match = !q || cmd.includes(q) || aliases.includes(q) || resp.includes(q);
                        row.style.display = match ? '' : 'none';
                    });
                });
            }
        }

        function updatePersonaCounter() {
            if (!els.personaTextarea || !els.personaCharCounter) return;
            const len = els.personaTextarea.value.length;
            els.personaCharCounter.textContent = `${len.toLocaleString()} / 16,000 characters`;
            if (len > 16000) {
                els.personaCharCounter.classList.add('error');
            } else {
                els.personaCharCounter.classList.remove('error');
            }
        }

        function openConfigModal() {
            if (!els.configModal) return;
            const dialog = els.configModal.querySelector('.modal-dialog');
            if (dialog) dialog.classList.remove('modal-shake');
            els.configModal.style.display = 'flex';
            updateErrorsGateVisibility();
            loadConfig();
        }

        function closeConfigModal() {
            if (!els.configModal) return;
            const dialog = els.configModal.querySelector('.modal-dialog');
            if (dialog) dialog.classList.remove('modal-shake');
            els.configModal.style.display = 'none';
            if (els.modalSaveNotice) els.modalSaveNotice.textContent = '';
        }

        function switchModalTab(tabKey) {
            state.activeModalTab = tabKey;
            document.querySelectorAll('.modal-tab').forEach(t => {
                t.classList.toggle('active', t.dataset.tab === tabKey);
            });
            document.querySelectorAll('.tab-pane').forEach(p => {
                p.style.display = p.id === `pane-${tabKey}` ? 'flex' : 'none';
                p.classList.toggle('active', p.id === `pane-${tabKey}`);
            });
            if (tabKey === 'error_messages') {
                updateErrorsGateVisibility();
                if (state.errorsUnlocked) {
                    renderErrorsMasterDetail();
                }
            }
            if (els.modalSaveNotice) els.modalSaveNotice.textContent = '';
        }

        async function loadConfig() {
            try {
                const res = await fetch('/api/config');
                if (!res.ok) return;
                state.config = await res.json();
                renderConfigForm();
            } catch (err) {
                console.error('Failed to load config:', err);
            }
        }

        function renderConfigForm() {
            if (!state.config) return;

            // 1. Persona
            if (els.personaTextarea) {
                els.personaTextarea.value = state.config.system_instructions || '';
                updatePersonaCounter();
            }
            updateStatusBadge('system_instructions', state.config.overrides?.system_instructions);

            // 2. Custom Commands
            if (els.commandsTbody) {
                els.commandsTbody.innerHTML = '';
                const commands = Array.isArray(state.config.custom_commands) ? state.config.custom_commands : [];
                commands.forEach(cmd => addCommandRow(cmd));
            }
            updateStatusBadge('custom_commands', state.config.overrides?.custom_commands);

            // 3. Event Alerts (Master-Detail 2-Panel)
            renderAlertsMasterDetail();
            updateStatusBadge('event_alerts', state.config.overrides?.event_alerts);

            // 4. Error Messages (Master-Detail 2-Panel)
            renderErrorsMasterDetail();
            updateStatusBadge('error_messages', state.config.overrides?.error_messages);
        }

        function updateStatusBadge(type, isOverride, isDirty = false) {
            const badge = document.getElementById(`status-${type}`);
            if (!badge) return;
            if (isDirty) {
                badge.innerHTML = '<span class="status-dot dirty">●</span> Unsaved Changes';
                badge.className = 'pane-status dirty';
            } else if (isOverride) {
                badge.innerHTML = '<span class="status-dot override">●</span> Custom Config';
                badge.className = 'pane-status override';
            } else {
                badge.innerHTML = '<span class="status-dot default">●</span> Factory Preset';
                badge.className = 'pane-status';
            }
        }

        function getBotDisplayName() {
            return window.__VIEWER__?.displayName || window.__VIEWER__?.login || 'TwitchBot';
        }

        function addCommandRow(cmd = {}) {
            if (!els.commandsTbody) return;
            const tr = document.createElement('tr');
            const aliasesStr = Array.isArray(cmd.aliases) ? cmd.aliases.join(', ') : (cmd.aliases || '');
            tr.innerHTML = `
                <td><input type="text" class="table-input cmd-name" value="${escapeHtml(cmd.command || '')}" placeholder="!command" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></td>
                <td><input type="text" class="table-input cmd-aliases" value="${escapeHtml(aliasesStr)}" placeholder="!alias1, !alias2" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></td>
                <td><input type="text" class="table-input cmd-resp" value="${escapeHtml(cmd.response || '')}" placeholder="Response text" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></td>
                <td>
                    <select class="table-select cmd-role">
                        <option value="all" ${cmd.role === 'all' ? 'selected' : ''}>Everyone</option>
                        <option value="moderator" ${cmd.role === 'moderator' ? 'selected' : ''}>Moderator+</option>
                        <option value="broadcaster" ${cmd.role === 'broadcaster' ? 'selected' : ''}>Broadcaster Only</option>
                    </select>
                </td>
                <td style="text-align: center;"><button class="btn btn-danger btn-del-row" title="Delete">✕</button></td>
            `;
            const nameInput = tr.querySelector('.cmd-name');
            const aliasInput = tr.querySelector('.cmd-aliases');
            const respInput = tr.querySelector('.cmd-resp');
            const roleSelect = tr.querySelector('.cmd-role');

            nameInput.addEventListener('blur', () => {
                let v = nameInput.value.trim();
                if (v && !v.startsWith('!')) nameInput.value = `!${v}`;
            });
            aliasInput.addEventListener('blur', () => {
                let parts = aliasInput.value.split(',').map(s => s.trim()).filter(Boolean);
                aliasInput.value = parts.map(p => p.startsWith('!') ? p : `!${p}`).join(', ');
            });
            nameInput.addEventListener('input', () => updateStatusBadge('custom_commands', true, true));
            aliasInput.addEventListener('input', () => updateStatusBadge('custom_commands', true, true));
            respInput.addEventListener('input', () => updateStatusBadge('custom_commands', true, true));
            roleSelect.addEventListener('change', () => updateStatusBadge('custom_commands', true, true));
            tr.querySelector('.btn-del-row').addEventListener('click', () => {
                tr.remove();
                updateStatusBadge('custom_commands', true, true);
            });
            els.commandsTbody.appendChild(tr);
        }

        function collectCommandsFromTable() {
            if (!els.commandsTbody) return [];
            const rows = els.commandsTbody.querySelectorAll('tr');
            const list = [];
            for (const row of rows) {
                let command = row.querySelector('.cmd-name')?.value.trim();
                let aliasesRaw = row.querySelector('.cmd-aliases')?.value.trim() || '';
                const response = row.querySelector('.cmd-resp')?.value.trim();
                const role = row.querySelector('.cmd-role')?.value || 'all';
                if (command && response) {
                    if (!command.startsWith('!')) command = `!${command}`;
                    const aliases = aliasesRaw
                        ? aliasesRaw.split(',').map(s => s.trim()).filter(Boolean).map(a => a.startsWith('!') ? a : `!${a}`)
                        : [];
                    list.push({ command, aliases, response, role });
                }
            }
            return list;
        }

        // --- 2-PANEL MASTER-DETAIL ALERTS LOGIC ---
        function renderAlertsMasterDetail() {
            if (!state.config?.event_alerts) state.config.event_alerts = {};
            if (!state.selectedAlertKind || !ALERT_SPECS.some(s => s.kind === state.selectedAlertKind)) {
                state.selectedAlertKind = ALERT_SPECS[0].kind;
            }
            renderAlertsNav();
            renderAlertDetail(state.selectedAlertKind);
        }

        function renderAlertsNav() {
            if (!els.alertsNavList) return;
            els.alertsNavList.innerHTML = '';
            const alerts = state.config?.event_alerts || {};

            ALERT_SPECS.forEach(spec => {
                const data = alerts[spec.kind] || {};
                const enabled = data.enabled !== false;
                const aiEnabled = data.ai_enabled !== false;
                const isActive = spec.kind === state.selectedAlertKind;

                const navItem = document.createElement('div');
                navItem.className = `alerts-nav-item ${isActive ? 'active' : ''}`;
                navItem.dataset.kind = spec.kind;

                let modeBadgeHtml = '';
                if (spec.isChannelPoints) {
                    modeBadgeHtml = enabled
                        ? '<span class="alert-mode-badge badge-ai">Enabled</span>'
                        : '<span class="alert-mode-badge badge-off">Off</span>';
                } else {
                    if (!enabled) {
                        modeBadgeHtml = '<span class="alert-mode-badge badge-off">Off</span>';
                    } else if (aiEnabled) {
                        modeBadgeHtml = '<span class="alert-mode-badge badge-ai">✨ AI</span>';
                    } else {
                        modeBadgeHtml = '<span class="alert-mode-badge badge-tpl">💬 Static</span>';
                    }
                }

                navItem.innerHTML = `
                    <div class="alerts-nav-left">
                        <div class="alerts-nav-title">${escapeHtml(spec.title)}</div>
                        <div class="alerts-nav-meta">
                            <span class="nav-mode-slot">${modeBadgeHtml}</span>
                        </div>
                    </div>
                    <div class="alerts-nav-right" onclick="event.stopPropagation();">
                        <label class="switch-toggle small" title="Toggle ${escapeHtml(spec.title)}">
                            <input type="checkbox" class="nav-alert-toggle" ${enabled ? 'checked' : ''}>
                            <span class="switch-slider"></span>
                        </label>
                    </div>
                `;

                const toggleInput = navItem.querySelector('.nav-alert-toggle');
                toggleInput.addEventListener('change', () => {
                    const isEn = toggleInput.checked;
                    if (!state.config.event_alerts[spec.kind]) state.config.event_alerts[spec.kind] = {};
                    state.config.event_alerts[spec.kind].enabled = isEn;

                    // Update left mode badge
                    const slot = navItem.querySelector('.nav-mode-slot');
                    if (slot) {
                        if (spec.isChannelPoints) {
                            slot.innerHTML = isEn
                                ? '<span class="alert-mode-badge badge-ai">Enabled</span>'
                                : '<span class="alert-mode-badge badge-off">Off</span>';
                        } else {
                            const curAi = state.config.event_alerts[spec.kind].ai_enabled !== false;
                            if (!isEn) {
                                slot.innerHTML = '<span class="alert-mode-badge badge-off">Off</span>';
                            } else if (curAi) {
                                slot.innerHTML = '<span class="alert-mode-badge badge-ai">✨ AI</span>';
                            } else {
                                slot.innerHTML = '<span class="alert-mode-badge badge-tpl">💬 Static</span>';
                            }
                        }
                    }

                    // If currently selected alert, update detail panel toggle too
                    if (state.selectedAlertKind === spec.kind) {
                        const detailToggle = els.alertsDetailPanel?.querySelector('.detail-enabled-toggle');
                        if (detailToggle && detailToggle.checked !== isEn) {
                            detailToggle.checked = isEn;
                        }
                    }
                    updateStatusBadge('event_alerts', true, true);
                });

                navItem.addEventListener('click', () => {
                    if (state.selectedAlertKind !== spec.kind) {
                        selectAlert(spec.kind);
                    }
                });

                els.alertsNavList.appendChild(navItem);
            });
        }

        function selectAlert(kind) {
            flushActiveAlertDetail();
            state.selectedAlertKind = kind;

            if (els.alertsNavList) {
                els.alertsNavList.querySelectorAll('.alerts-nav-item').forEach(item => {
                    item.classList.toggle('active', item.dataset.kind === kind);
                });
            }
            renderAlertDetail(kind);
        }

        function flushActiveAlertDetail() {
            if (!els.alertsDetailPanel || !state.selectedAlertKind) return;
            const kind = state.selectedAlertKind;
            if (!state.config.event_alerts[kind]) state.config.event_alerts[kind] = {};
            const curData = state.config.event_alerts[kind];

            const detailToggle = els.alertsDetailPanel.querySelector('.detail-enabled-toggle');
            if (detailToggle) curData.enabled = detailToggle.checked;

            const cooldownInput = els.alertsDetailPanel.querySelector('.alert-cooldown');
            if (cooldownInput) curData.cooldown_seconds = Number(cooldownInput.value) || 0;

            const extraNum = els.alertsDetailPanel.querySelector('.alert-extra-num');
            if (extraNum) curData[extraNum.dataset.key] = Number(extraNum.value) || 0;

            const extraToggle = els.alertsDetailPanel.querySelector('.alert-extra-toggle');
            if (extraToggle) curData[extraToggle.dataset.key] = extraToggle.checked;

            if (kind === 'channel_points') {
                const rewards = {};
                els.alertsDetailPanel.querySelectorAll('.reward-rule-card').forEach(rc => {
                    const name = rc.querySelector('.reward-name-input')?.value.trim();
                    if (!name) return;
                    const rAiEnabled = rc.querySelector('.reward-ai-toggle')?.checked ?? true;
                    const rFallback = (rAiEnabled
                        ? rc.querySelector('.reward-fallback-input')?.value
                        : rc.querySelector('.reward-static-input')?.value)?.trim() || '';
                    const rPrompt = rc.querySelector('.reward-prompt-input')?.value.trim() || '';
                    rewards[name] = {
                        ai_enabled: rAiEnabled,
                        fallback_template: rFallback,
                        ai_prompt: rPrompt
                    };
                });
                curData.rewards = rewards;
            } else {
                const isAi = els.alertsDetailPanel.querySelector('.alert-ai-toggle')?.checked ?? true;
                curData.ai_enabled = isAi;
                const fallbackVal = (isAi
                    ? els.alertsDetailPanel.querySelector('.alert-fallback-input')?.value
                    : els.alertsDetailPanel.querySelector('.alert-static-input')?.value)?.trim() || '';
                curData.fallback_template = fallbackVal;
                curData.ai_prompt = els.alertsDetailPanel.querySelector('.alert-ai-prompt-input')?.value.trim() || '';
            }
        }

        function attachInputSyntaxHighlighter(inputEl, validVars = []) {
            if (!inputEl) return;
            const wrapper = inputEl.closest('.highlight-input-wrapper');
            if (!wrapper) return;
            const backdrop = wrapper.querySelector('.highlight-backdrop');
            if (!backdrop) return;

            const isTextarea = inputEl.tagName === 'TEXTAREA';

            const update = () => {
                const val = inputEl.value || '';
                let escaped = escapeHtml(val);
                escaped = escaped.replace(/\{([a-zA-Z0-9_]+)\}/g, (match, vName) => {
                    const isValid = validVars.includes(vName);
                    return isValid 
                        ? `<mark class="token-var valid">${match}</mark>`
                        : `<mark class="token-var invalid">${match}</mark>`;
                });

                if (isTextarea) {
                    if (val.endsWith('\n')) escaped += ' ';
                    backdrop.innerHTML = escaped;

                    // Strictly clamp height between 38px (1 line) and 82px (3 lines max)
                    inputEl.style.height = 'auto';
                    const scrollH = inputEl.scrollHeight;
                    if (scrollH > 0) {
                        const nextHeight = Math.min(Math.max(scrollH, 38), 82);
                        inputEl.style.height = `${nextHeight}px`;
                        const hasOverflow = scrollH > 82;
                        inputEl.classList.toggle('has-overflow', hasOverflow);
                        inputEl.style.overflowY = hasOverflow ? 'auto' : 'hidden';
                    }
                    backdrop.scrollTop = inputEl.scrollTop;
                } else {
                    backdrop.innerHTML = escaped;
                    backdrop.scrollLeft = inputEl.scrollLeft;
                }
            };

            // Prevent Enter key from creating empty newlines (prompts are natural word-wrapping single expressions)
            if (isTextarea) {
                inputEl.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                    }
                });
            }

            inputEl.addEventListener('input', update);
            inputEl.addEventListener('scroll', () => {
                if (isTextarea) {
                    backdrop.scrollTop = inputEl.scrollTop;
                } else {
                    backdrop.scrollLeft = inputEl.scrollLeft;
                }
            });

            update();
            requestAnimationFrame(update);
        }

