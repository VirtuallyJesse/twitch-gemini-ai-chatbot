                    }
                    if (previewText) previewText.textContent = 'Generating real AI response from Gemini...';

                    try {
                        const res = await fetch(`/gemini/${encodeURIComponent(interpolated)}`);
                        if (!res.ok) {
                            const errText = await res.text();
                            throw new Error(errText || 'Failed to generate AI response');
                        }
                        const aiAnswer = await res.text();
                        if (previewText) previewText.textContent = aiAnswer;
                        if (previewTag) {
                            previewTag.textContent = '✨ AI TEST OUTPUT';
