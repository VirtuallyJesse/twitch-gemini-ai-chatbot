<!-- Tab 4: Error Messages (2-Panel Master-Detail) -->
<div class="tab-pane" id="pane-error_messages" style="display: none;">
    <!-- Advanced User Gate Blocker -->
    <div class="errors-gate-overlay" id="errors-gate-overlay">
        <div class="errors-gate-card">
            <div class="errors-gate-icon">⚠️</div>
            <strong class="errors-gate-title">This section is for advanced users!</strong>
            <button type="button" class="btn btn-primary btn-errors-proceed" id="btn-errors-proceed">Proceed</button>
        </div>
    </div>

    <!-- Main Errors Content (Hidden behind gate until unlocked) -->
    <div class="errors-content-wrapper" id="errors-content-wrapper" style="display: none;">
        <div class="pane-header">
            <span class="pane-status" id="status-error_messages"><span class="status-dot">●</span> Factory Preset</span>
            <div class="pane-actions">
                <button class="btn btn-secondary btn-reset" data-type="error_messages" title="Restore factory default errors preset">↺ Restore Defaults</button>
                <button class="btn btn-primary btn-save" data-type="error_messages">Save Errors</button>
            </div>
        </div>
        <div class="config-guidance errors-guidance">
            <strong>💡 Tip:</strong> Error messages are pre-written fallback notices sent to chat if an external API or service fails. The bot works reliably out of the box with factory defaults. Customize these only if you want bot failure responses to match your channel's unique persona.
        </div>

        <!-- 2-Panel Master-Detail Error Catalog -->
        <div class="errors-master-detail" id="errors-master-detail">
            <!-- Left Categories Nav -->
            <div class="errors-nav-panel">
                <div class="errors-nav-header">
                    <span class="nav-panel-title">Categories</span>
                </div>
                <div class="errors-nav-list" id="errors-nav-list">
                    <!-- Nav category items injected here -->
                </div>
            </div>
            <!-- Right Detail Panel Canvas -->
            <div class="errors-detail-panel" id="errors-detail-panel">
                <!-- Category error items injected here -->
            </div>
        </div>
    </div>
</div>
